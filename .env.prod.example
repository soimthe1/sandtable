# sandtable production secrets. Copy to .env.prod next to docker-compose.prod.yaml.
# Only secrets live here; every other setting is in config/config.yaml and config/config.prod.yaml.
#
# Key for an LLM endpoint that needs one. Used only by an ai: profile that sets
# `api_key_env: LLM_API_KEY`. Leave empty for Ollama or an open vLLM server.
LLM_API_KEY=
