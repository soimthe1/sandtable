# sandtable development secrets. Copy to .env (git-ignored).
# Only secrets live here; every other setting is in config/config.yaml.
#
# Key for an LLM endpoint that needs one. Used only by an ai: profile in config.yaml
# that sets `api_key_env: LLM_API_KEY`. Leave empty for Ollama or an open vLLM server.
LLM_API_KEY=
